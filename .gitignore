# Python 缓存（运行代码后自动产生）
__pycache__/
*.py[cod]

# 虚拟环境
.venv/
venv/

# PyInstaller 打包产物（M5 阶段产生）
build/
dist/

# PyInstaller 生成的 spec 文件。
# 如果将来需要手工定制打包配置，应改为纳入版本库（git add -f）并删除本行。
*.spec

# 本地测试图片。
# 规则：测试图片不进版本库。
samples/

# 项目管理文档：只在本地维护，不纳入版本库、不推送。
# 这些文件是开发过程中的计划与协作规则，不属于工具本身。
PROJECT.md
ROADMAP.md
TASKS.md
AGENTS.md
